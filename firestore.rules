rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider in ['google.com', 'anonymous'];
    }

    function household(code) {
      return get(/databases/$(database)/documents/households/$(code)).data;
    }

    function isMember(code) {
      return signedIn() && household(code).memberProfiles[request.auth.uid] is string;
    }

    function isAdmin(code) {
      return signedIn() && household(code).adminUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.householdCode is string
        && request.resource.data.displayName is string
        && request.resource.data.role in ['admin', 'member'];
      allow delete: if signedIn() && (
        request.auth.uid == userId
        || (resource.data.householdCode is string && isAdmin(resource.data.householdCode))
      );
    }

    match /households/{code} {
      // A Google-authenticated user may look up a household by its shared code.
      allow get: if signedIn();
      allow list: if false;

      // The creator becomes the immutable admin for this household.
      allow create: if signedIn()
        && request.resource.data.adminUid == request.auth.uid
        && request.resource.data.adminName is string
        && request.resource.data.memberProfiles[request.auth.uid] == request.resource.data.adminName
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0] == request.resource.data.adminName;

      // Admin can manage members but cannot transfer admin ownership.
      allow update: if isAdmin(code)
        && request.resource.data.adminUid == resource.data.adminUid
        && request.resource.data.adminName == resource.data.adminName
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'memberProfiles']);

      // A non-member may join by adding exactly their own UID/profile.
      // Validate the new profile value and member count without using map.diff(),
      // which can reject valid dynamic UID field updates.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.memberProfiles)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'memberProfiles'])
        && request.auth.uid in request.resource.data.memberProfiles
        && request.resource.data.memberProfiles[request.auth.uid] is string
        && request.resource.data.memberProfiles.size()
          == resource.data.memberProfiles.size() + 1
        && request.resource.data.members.size()
          == resource.data.members.size() + 1
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.hasAny([
          request.resource.data.memberProfiles[request.auth.uid]
        ]);

      allow delete: if false;

      match /{subcollection}/{docId} {
        allow read, write: if isMember(code);
      }
    }
  }
}
